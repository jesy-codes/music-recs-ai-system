# Spotify Developer app credentials.
# Copy this file to `.env` (which is git-ignored) and fill in your real values:
#   cp .env.example .env
# Find them at https://developer.spotify.com/dashboard -> your app -> Settings.

SPOTIFY_CLIENT_ID=your-client-id-here
SPOTIFY_CLIENT_SECRET=your-client-secret-here

# Must exactly match a Redirect URI registered in your app's Settings.
# Spotify no longer accepts "localhost"; use the loopback IP instead.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
